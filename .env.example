# ai-sentiment: copy this file to .env, then fill in credentials.
# .env is ignored by Git. Changes take effect after restarting the worker.
# SAVE_DB=false skips REST writes, but provider calls can still cost money.

# 1. REST API and provider connections
BE_API_BASE_URL=https://api.blueeye.io/api/v1
BE_API_TOKEN=replace_with_rest_internal_token
OPENROUTER_API_KEY=replace_with_openrouter_key
GEMINI_API_KEY=replace_with_gemini_key
OLLAMA_HOST=http://localhost:11434

# 2. Provider switches (false means no calls to that provider)
ENABLE_OPENROUTER=true
ENABLE_OLLAMA=true
ENABLE_GEMINI=true

# 3. Models and OpenRouter routing
# Plain model names use Ollama; api: uses Gemini; openrouter: uses OpenRouter.
VALIDATION_MODELS=gemma4:31b-cloud,api:gemma-4-26b-a4b-it,api:gemma-4-31b-it,api:gemini-3.1-flash-lite,api:gemini-3.5-flash-lite,api:gemini-2.5-flash,api:gemini-2.5-flash-lite,api:gemini-3.5-flash
OLLAMA_MODEL=qcwind/qwen3-8b-instruct-Q4-K-M:latest
JEV_MODEL=typesafe/jev-1.13
JEV_FALLBACK_MODELS=~typesafe/jev-latest,typesafe/jev-latest
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_PROVIDERS=relace/fp4
OPENROUTER_ALLOW_FALLBACKS=true

# 4. Provider order by Thailand time (UTC+07:00)
# 08:00-21:59 OpenRouter first; 22:00-07:59 Gemini, Ollama, OpenRouter.
PROVIDER_SCHEDULE_ENABLED=true
OPENROUTER_SCHEDULE_START=08:00
OPENROUTER_SCHEDULE_END=22:00

# 5. Analysis and provider requests
ENABLE_JEV_HYBRID=true
ENABLE_PROBABILISTIC_MODE=true
BYPASS_LOCAL_TRIAGE=true
HYBRID_PROMPT_V2=true
AI_COST_MODE=low
JEV_TEXT_MAX_CHARS=1800
JEV_API_TIMEOUT=20
JEV_MAX_RETRIES=3
DEEPSEEK_API_TIMEOUT=45
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=400
DEEPSEEK_TEXT_MAX_CHARS=1200
DEEPSEEK_INCLUDE_JEV_SIGNAL=true
OPENROUTER_API_TIMEOUT=45
OPENROUTER_MAX_RETRIES=2

# 6. Concurrency per worker process
CONCURRENT_WORKERS=16
MAX_IN_FLIGHT=24
BATCH_SIZE=20
DEEPSEEK_MAX_CONCURRENCY=6
GEMINI_MAX_CONCURRENCY=1
OLLAMA_MAX_CONCURRENCY=1

# 7. Continuous worker
RUN_INTERVAL_SECONDS=5
SAVE_DB=false
