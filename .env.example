# REST-only production worker. Copy to .env and provide real credentials there.
# Never commit .env. SAVE_DB=false still invokes paid models, but does not POST results.
BE_API_BASE_URL=https://api.blueeye.io/api/v1
BE_API_TOKEN=replace_with_rest_internal_token
OPENROUTER_API_KEY=replace_with_openrouter_key
OPENROUTER_PROVIDERS=sail-research/fp4
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_API_TIMEOUT=45
OPENROUTER_MAX_RETRIES=2

# Jev fast path and DeepSeek slow path. The Jev acceptance threshold is fixed at 0.65.
ENABLE_JEV_HYBRID=true
HYBRID_PROMPT_V2=true
JEV_MODEL=typesafe/jev-1.13
JEV_FALLBACK_MODELS=~typesafe/jev-latest,typesafe/jev-latest
JEV_API_TIMEOUT=20
JEV_MAX_RETRIES=3
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash-0731
DEEPSEEK_API_TIMEOUT=45
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_CONCURRENCY=4
DEEPSEEK_MAX_TOKENS=400
DEEPSEEK_TEXT_MAX_CHARS=3000
DEEPSEEK_INCLUDE_JEV_SIGNAL=true

# One REST process only. These limits apply per process.
CONCURRENT_WORKERS=12
MAX_IN_FLIGHT=20
BATCH_SIZE=20
RUN_INTERVAL_SECONDS=5
SAVE_DB=false
